# StudyForge configuration. Copy to .env for local dev: `cp .env.example .env`.
# On Vercel, set these under Project → Settings → Environment Variables
# (see docs/DEPLOY.md). [Vercel: …] says whether a variable is needed there.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: a SQLite file. On Vercel: the Turso URL (libsql://<db>-<org>.turso.io).
# [Vercel: required — unless the Turso Marketplace integration injects
#  TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, which are used as fallbacks]
DATABASE_URL="file:./dev.db"
# Turso auth token. Not used for file: URLs.
# DATABASE_AUTH_TOKEN=

# ── Claude ──────────────────────────────────────────────────────────────────
# Without a key the app runs in offline Demo mode.
# [Vercel: required for real card generation]
# ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your API key is not scoped to a workspace. [Vercel: optional]
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# Defaults to claude-opus-5-5. [Vercel: optional]
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Password gate ───────────────────────────────────────────────────────────
# When set, every page and API route needs this password (login at /login).
# Leave unset for local dev. [Vercel: required — otherwise anyone with the URL
# can spend your Anthropic credits]
# APP_PASSWORD=
# Key for signing the 30-day session cookie. If unset, a key is derived from
# APP_PASSWORD. Changing either logs everyone out. Generate one with
# `openssl rand -base64 32`. [Vercel: recommended]
# APP_SECRET=

# ── File uploads ────────────────────────────────────────────────────────────
# Set automatically when you add a Vercel Blob store (Storage tab). With it,
# browsers upload straight to Blob (up to 25 MB per file). Without it, uploads
# go to .uploads/ on local disk. [Vercel: required — injected by the Blob store]
# BLOB_READ_WRITE_TOKEN=
# Access level of the Blob store: "private" (default; create the store as
# Private) or "public". [Vercel: optional]
# BLOB_ACCESS=private
# Local file store directory (default .uploads). [local only]
# UPLOAD_DIR=.uploads

# ── Time budget ─────────────────────────────────────────────────────────────
# On Vercel, generation stops starting new parts ~100 s before the 300 s
# function limit and returns what it has. Set this to apply a budget locally
# (seconds) or override the Vercel default. [optional]
# GENERATION_TIME_BUDGET_SECONDS=
